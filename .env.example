# =============================================================
# Curriculum Gap Analysis Pipeline - Environment Configuration
# =============================================================
# Copy this file to .env and modify as needed:
#   cp .env.example .env

# ----- LLM Configuration -----
# Set to "true" to use an LLM for enhanced analysis.
# Set to "false" (default) for fully offline deterministic mode.
LLM_ENABLED=false

# 1. OPTION A: OpenAI (ChatGPT)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# 2. OPTION B: Microsoft Azure OpenAI
# LLM_PROVIDER=azure
# LLM_MODEL=your-deployment-name
# LLM_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# 3. OPTION C: Groq (Fast Inference)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1

# 4. OPTION D: DeepSeek
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1

# 5. OPTION E: OpenRouter (Gemini, Claude, Llama, etc.)
# LLM_PROVIDER=openrouter
# LLM_MODEL=google/gemini-2.0-flash-001
# LLM_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1

# 6. OPTION F: Local Ollama (Completely Free & Local)
# LLM_PROVIDER=custom
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1

# Current Active Settings:
q

# ----- Embedding Model -----
# Local sentence-transformers model (downloaded once, then cached)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----- Gap Detection Thresholds -----
# Similarity score >= COVERED_THRESHOLD → COVERED
COVERED_THRESHOLD=0.75
# Similarity score >= PARTIAL_THRESHOLD → PARTIAL
PARTIAL_THRESHOLD=0.45
# Similarity score < PARTIAL_THRESHOLD → MISSING

# ----- RAG Settings -----
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ----- Database -----
DATABASE_URL=sqlite:///storage/app.db

# ----- ChromaDB -----
CHROMA_PERSIST_DIR=storage/chroma_db

# ----- File Storage -----
UPLOAD_DIR=storage/uploads
REPORTS_DIR=storage/reports

# ----- Server -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ----- Upload Limits -----
MAX_UPLOAD_SIZE_MB=10
