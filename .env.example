# =============================================================
# Curriculum Gap Analysis Pipeline - Environment Configuration
# =============================================================
# Copy this file to .env and modify as needed:
#   cp .env.example .env

# ----- LLM Configuration -----
# Set to "true" to use an LLM for enhanced analysis.
# Set to "false" (default) for fully offline deterministic mode.
LLM_ENABLED=false

# LLM provider: "openai", "azure", or leave blank for offline
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# ----- Embedding Model -----
# Local sentence-transformers model (downloaded once, then cached)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----- Gap Detection Thresholds -----
# Similarity score >= COVERED_THRESHOLD → COVERED
COVERED_THRESHOLD=0.75
# Similarity score >= PARTIAL_THRESHOLD → PARTIAL
PARTIAL_THRESHOLD=0.45
# Similarity score < PARTIAL_THRESHOLD → MISSING

# ----- RAG Settings -----
# Number of top results to retrieve per query
RAG_TOP_K=5
# Chunk size in characters for document splitting
RAG_CHUNK_SIZE=500
# Overlap between chunks in characters
RAG_CHUNK_OVERLAP=50

# ----- Database -----
# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///storage/app.db

# ----- ChromaDB -----
# Persistent storage path for vector database
CHROMA_PERSIST_DIR=storage/chroma_db

# ----- File Storage -----
UPLOAD_DIR=storage/uploads
REPORTS_DIR=storage/reports

# ----- Server -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ----- Upload Limits -----
MAX_UPLOAD_SIZE_MB=10
